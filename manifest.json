{
  "manifest_version": 3,
  "name": "Comic Sans Override",
  "version": "1.2",
  "description": "Forces Comic Sans on sites that use Inter / quote-cjk-patch.",
  "browser_specific_settings": {
    "gecko": {
      "id": "comic-sans-override@nilknarfgonzo.bsky.social",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "css": ["comic.css"],
      "run_at": "document_start"
    }
  ]
}